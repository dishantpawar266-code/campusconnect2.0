# CampusConnect 2.0 - Environment Variable Documentation (.env.example)
# Copy this file to .env for local testing. NEVER commit real secret values to GitHub.

# Supabase PostgreSQL Connection String (Transaction Pooler port 6543 or Session Pooler port 5432)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Supabase API Credentials (Required for Supabase Storage persistent file uploads)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=campusconnect-files

# Flask Session Security Key
SECRET_KEY=campus_connect_secret_key_2026_rcpit

# Developer Admin Account Credentials (Seeded into database on initial deployment)
ADMIN_EMAIL=dishantpawar04@gmail.com
ADMIN_PASSWORD=Admin@Campus2026!
